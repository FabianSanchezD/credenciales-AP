# Entorno: development | production | test
NODE_ENV=development
PORT=4000
# Orígenes de las web apps (wallet, emisor, verificador, gobernanza)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
# testnet | mainnet
STELLAR_NETWORK=testnet
# Opcional: sobrescribe el Horizon por defecto de la red
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Archivo SQLite (la carpeta se crea sola). Las pruebas usan :memory:
DATABASE_PATH=./data/credenciales.db

# Opcional: desafíos y sesiones en Redis. Sin esta variable viven en memoria.
# REDIS_URL=redis://localhost:6379

# Cuentas Stellar (G...) de la entidad que autoriza, separadas por coma
GOBERNANZA_CUENTAS=
# Solo desarrollo: cualquier cuenta entra a la consola de gobernanza.
# La API no arranca con esta opción en NODE_ENV=production.
GOBERNANZA_ABIERTA=false

# Anclaje de credenciales (ADR 0001): stellar (por defecto) | acta
# (memoria solo se permite con NODE_ENV=test)
ANCLAJE_DRIVER=stellar
# Obligatoria con ANCLAJE_DRIVER=acta; se crea en dapp.acta.build
# ACTA_API_KEY=
# Opcional: sobrescribe la URL de la API de ACTA
# ACTA_API_URL=https://sandbox-api.acta.build

# Llave AES-256 de la bóveda: 64 caracteres hexadecimales.
# Obligatoria en producción; genera una con: openssl rand -hex 32
# Sin ella, fuera de producción se usa una llave fija de desarrollo.
# BOVEDA_CLAVE=
